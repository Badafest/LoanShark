@page "/"
@inject NavigationManager NavManager
@inject GameData gameData

<h1 id="game-title">LOAN SHARK</h1>

<button id="play-button" @onclick="GoToGame">
    <span>PLAY</span>
    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" stroke-width="0" stroke="none"
         height="1.25rem">
        <path fill-rule="evenodd"
              d="M4.5 5.653c0-1.427 1.529-2.33 2.779-1.643l11.54 6.347c1.295.712 1.295 2.573 0 3.286L7.28 19.99c-1.25.687-2.779-.217-2.779-1.643V5.653Z"
              clip-rule="evenodd" />
    </svg>
</button>

@code {
    async Task GoToGame()
    {
        gameData.Reset();
        await gameData.LoadApplicantDetails();
        if (gameData.State == GameState.APPLICANTS_LOADED)
        {
            NavManager.NavigateTo("/play");
        }
    }
}

